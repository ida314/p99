/* One accent colour (cyan), one warning colour (yellow), everything
   else is the terminal's own palette. The screens are dense text; chrome
   should stay out of the way. */

Screen {
    background: $surface;
}

#banner {
    color: $accent;
    text-style: bold;
    height: auto;
    margin: 0 2;
}

.tagline {
    color: $text-muted;
    margin: 0 4 1 4;
}

.panel {
    height: auto;
    margin: 0 2;
    padding: 0 1;
}

/* The home menu is a real list so j/k and enter reach it, but it should read
   as a menu: no border, no scrollbar, sized to its entries.

   Two columns, and the row is bounded to the width of the overview panel above
   it rather than left at 1fr — full width shoves the right column against the
   screen edge, and two lists forty columns apart do not read as one menu. The
   Horizontal needs `height: auto` too, or it claims the rest of the screen and
   pushes the footer off the bottom. */
#menu-block {
    height: auto;
    margin: 1 2;
}

#menu-columns {
    width: 62;
    height: auto;
}

/* The resume row spans both columns and is sized to its own sentence, which is
   longer than either of them. */
#menu-resume {
    width: auto;
    height: auto;
}

#menu, #menu-right {
    width: 1fr;
    height: auto;
}

#menu-resume, #menu, #menu-right {
    margin: 0;
    padding: 0;
    border: none;
    background: transparent;
    scrollbar-size: 0 0;
}

.section-title {
    color: $accent;
    text-style: bold;
    margin: 1 2 0 2;
}

.hint-bar {
    dock: bottom;
    height: 1;
    background: $panel;
    color: $text-muted;
    padding: 0 2;
}

/* --- setup ------------------------------------------------------------- */

#setup-controls {
    height: auto;
    margin: 1 2 0 2;
}

#setup-controls Input {
    width: 1fr;
}

#count {
    width: 12;
    margin-left: 1;
}

#problem-list {
    margin: 1 2;
    height: 1fr;
    border: round $panel;
}

#setup-status {
    margin: 0 2;
    color: $text-muted;
    height: 1;
}

/* --- queue ------------------------------------------------------------- */

/* Same treatment as the setup screen's list, because it is the same gesture:
   space picks, and what is picked is what runs. */
#queue-list {
    margin: 1 2;
    height: 1fr;
    border: round $panel;
}

#queue-status {
    margin: 0 2;
    height: 1;
}

#queue-rationale {
    margin: 0 2 1 2;
    height: auto;
}

/* --- settings ---------------------------------------------------------- */

/* Same treatment as the home menu: a real list so j/k reach it, drawn as
   plain rows rather than a widget. */
#settings-list {
    height: auto;
    margin: 1 2;
    padding: 0;
    border: none;
    background: transparent;
    scrollbar-size: 0 0;
}

#settings-help {
    margin: 1 2 0 2;
    height: auto;
    color: $text-muted;
}

#settings-source {
    margin: 0 2;
    height: auto;
    color: $text-muted;
}

/* --- solve ------------------------------------------------------------- */

#solve-body {
    height: 1fr;
}

#progress {
    color: $text-muted;
    margin: 1 2 0 2;
}

#problem-title {
    text-style: bold;
    margin: 0 2;
}

/* Pattern and tags. Hidden until c: "hash-table, two-pointers" is an approach
   hint you never asked for and were never charged for. */
#problem-meta {
    color: $text-muted;
    margin: 0 2;
    display: none;
}

#problem-meta.visible {
    display: block;
}

#problem-url {
    color: $accent;
    margin: 0 2;
}

/* "seen twice before · 12d ago · SOLVED WITH HINTS in 18:42" — always on, so
   that opening a problem always answers "have I done this before". r opens
   the rest of the record underneath the hint panel, where it moves nothing. */
#last-attempt {
    height: auto;
    margin: 0 0 1 0;
}

#timer {
    margin: 1 2;
    height: auto;
    color: $accent;
}

#attempt-state {
    margin: 0 2;
    height: auto;
}

/* status line for the last thing that happened — sits under the numbers you
   are already looking at rather than docked at the bottom of the terminal */
#toast {
    height: 1;
    margin: 1 2;
    color: $text-muted;
}

#hint-panel {
    margin: 0 2;
    padding: 1 2;
    height: auto;
    border: round $warning;
    display: none;
}

#hint-panel.visible {
    display: block;
}

/* Left margin 0: these lines carry render.py's own two-space gutter, so they
   line up with the widgets above without borrowing a column from the table. */
#past-attempts {
    margin: 1 0 1 0;
    height: auto;
    display: none;
}

#past-attempts.visible {
    display: block;
}

/* --- offline cache ------------------------------------------------------ */

#fetch-body {
    height: 1fr;
}

/* The progress line replaces itself in place, so it holds its height rather
   than making the panel below it jump on every problem. */
#fetch-progress {
    height: 3;
    margin: 1 0 0 0;
}

#fetch-failures {
    height: auto;
    margin: 1 0 0 0;
}

/* --- modals ------------------------------------------------------------ */

FinishModal {
    align: center middle;
}

/* Wide enough for three buttons on one row: save / throw away / back.
   Bounded and scrollable because the verdict ladder makes this the tallest
   thing in the app: on a short terminal the button row was landing below the
   fold, where you cannot see that "throw away" exists. */
#finish-box {
    width: 74;
    height: auto;
    max-height: 100%;
    overflow-y: auto;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#finish-box .field-label {
    color: $text-muted;
    margin-top: 1;
}

#finish-box Input {
    width: 1fr;
}

#optional-row, #complexity-row, #optimality-row {
    height: auto;
}

/* Two ladders side by side rather than stacked: the same question asked twice
   costs one line of height this way and four the other, and this modal is the
   one screen where height is the whole budget. */
.optimality-axis {
    width: 1fr;
    height: auto;
}

/* Nothing sets a border here on purpose: a RadioSet's border is how you see
   which of the two axes has focus. */
#finish-box .axis-label {
    color: $text-muted;
    padding-left: 1;
}

/* Pinned, so the three actions stay on screen while the verdict ladder above
   them scrolls. Only inside the finish modal — the confirm modal is short. */
#finish-box #confirm-buttons {
    dock: bottom;
    background: $surface;
}

ConfirmModal {
    align: center middle;
}

#confirm-box {
    width: 54;
    height: auto;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}

/* Same box, wider: three buttons and a line of prose for each of them. A
   narrower one wraps "keep going" onto a second row, where the way out of the
   prompt is the option you can't see. */
EndRunModal {
    align: center middle;
}

#end-run-box {
    width: 68;
    height: auto;
    padding: 1 2;
    border: round $warning;
    background: $surface;
}

#end-run-box .field-label {
    color: $text-muted;
    margin-top: 1;
}

#confirm-buttons {
    height: auto;
    margin-top: 1;
}

#confirm-buttons Button {
    margin-right: 2;
}

/* --- history / stats --------------------------------------------------- */

#history-body {
    height: 1fr;
}

#run-list {
    width: 26;
    border: round $panel;
    margin: 1 0 1 1;
}

/* The stat lines are drawn at a fixed 62 columns (render.WIDTH), so this pane
   spends its width carefully: a one-column gutter instead of a box, and a thin
   scrollbar. A box border here costs six columns and wraps every rule. */
#detail-pane {
    width: 1fr;
    margin: 1 0 1 1;
    border-left: tall $panel;
    scrollbar-size-vertical: 1;
}

/* No padding: every line render.py emits already starts with its own two
   spaces, and a stat line header is exactly WIDTH wide, so a single borrowed
   column wraps the difficulty tag onto its own line. */
#run-detail {
    height: auto;
    padding: 0;
}

/* h and l move between the two panes, so which one has focus has to be
   visible — otherwise j and k appear to act at random. */
#run-list:focus {
    border: round $accent;
}

#detail-pane:focus {
    border-left: tall $accent;
}

#stats-body {
    height: 1fr;
    margin: 1 0;
}

.dist-block {
    height: auto;
    margin: 0 2 1 2;
}

/* The strategy prompt. Narrower than the finish modal and mostly list: it asks
   one question, and the list is the answer. Height is capped so a vocabulary
   that has grown to forty entries scrolls rather than pushing the buttons off
   the bottom of an 80x24 terminal. */
StrategyModal {
    align: center middle;
}

#strategy-box {
    width: 68;
    height: auto;
    max-height: 100%;
    padding: 1 2;
    border: round $accent;
    background: $surface;
}

#strategy-box .field-label {
    color: $text-muted;
    margin-top: 1;
}

#strategy-list {
    height: auto;
    max-height: 12;
    border: none;
    background: $surface;
}

#strategy-box Input {
    width: 1fr;
    margin-top: 1;
}

/* The derived quality, and the inputs that decided it. Two lines, always
   present: a line that appears and disappears would move the buttons under it
   every time you press `w`. */
#strategy-quality {
    height: 2;
    margin-top: 1;
}

#strategy-box .hint-bar {
    color: $text-muted;
    margin-top: 1;
}

/* Docked for the same reason the finish modal's row is: the list above it
   scrolls, and the way out has to stay on screen. */
#strategy-box #confirm-buttons {
    dock: bottom;
    background: $surface;
}
